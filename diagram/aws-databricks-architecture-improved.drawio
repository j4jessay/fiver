        <mxCell id="legend-flow1" value="" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;strokeColor=#FF6F00;fontFamily=Amazon Ember;" edge="1" parent="legend-container">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
