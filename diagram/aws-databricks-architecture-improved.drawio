        <mxCell id="legend-databricks" value="Databricks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF3621;strokeColor=#B71C1C;fontColor=#FFFFFF;fontSize=9;fontStyle=1;fontFamily=Amazon Ember;" vertex="1" parent="legend-container">
          <mxGeometry x="110" y="35" width="90" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend-external" value="External Services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00ACC1;strokeColor=#00838F;fontColor=#FFFFFF;fontSize=9;fontStyle=1;dashed=1;dashPattern=8 4;fontFamily=Amazon Ember;" vertex="1" parent="legend-container">
          <mxGeometry x="210" y="35" width="90" height="30" as="geometry" />
