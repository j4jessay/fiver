          </mxGeometry>
        </mxCell>

        <!-- FLOW 4: Silver → Databricks → Gold -->
        <mxCell id="flow4-silver-db" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#0288D1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Amazon Ember;" edge="1" parent="aws-account" source="silver-zone" target="databricks-main">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="340" />
              <mxPoint x="640" y="280" />
            </Array>
          </mxGeometry>
