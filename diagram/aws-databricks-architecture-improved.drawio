            <Array as="points">
              <mxPoint x="445" y="250" />
              <mxPoint x="445" y="150" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="flow1-label" value="Ingested Data" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#E65100;fontStyle=1;fontFamily=Amazon Ember;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="flow1-ingestion">
