        <mxCell id="legend-aws" value="AWS Services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=9;fontFamily=Amazon Ember;" vertex="1" parent="legend-container">
          <mxGeometry x="10" y="35" width="90" height="30" as="geometry" />
