        <!-- ================== CONNECTIONS (SIMPLIFIED - 2 MAIN FLOWS) ================== -->

        <!-- FLOW 1: Sources → Ingestion → Bronze (consolidated) -->
        <mxCell id="flow1-ingestion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FF6F00;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Amazon Ember;" edge="1" parent="aws-account" target="bronze-zone">
