        <mxCell id="flow5-label" value="Curate" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#01579B;fontStyle=1;fontFamily=Amazon Ember;labelBackgroundColor=#E1F5FE;" vertex="1" connectable="0" parent="flow5-db-gold">
          <mxGeometry x="0.05" y="2" relative="1" as="geometry">
            <mxPoint x="-5" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- FLOW 6: Gold → Consumption (consolidated single line) -->
        <mxCell id="flow6-consumption" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#D84315;exitX=1;exitY=0.5;exitDx=0;exitDy=0;fontFamily=Amazon Ember;" edge="1" parent="aws-account" source="gold-zone">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1180" y="250" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1130" y="230" />
              <mxPoint x="1130" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="flow6-label" value="Analytics &amp; AI/ML" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#BF360C;fontStyle=1;fontFamily=Amazon Ember;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="flow6-consumption">
          <mxGeometry x="0.1" y="1" relative="1" as="geometry">
            <mxPoint x="-5" y="-10" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Medallion Flow Indicator -->
        <mxCell id="medallion-flow" value="← Bronze → Silver → Gold →" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#0277BD;fontStyle=1;fontFamily=Amazon Ember;" vertex="1" parent="aws-account">
          <mxGeometry x="690" y="360" width="210" height="30" as="geometry" />
