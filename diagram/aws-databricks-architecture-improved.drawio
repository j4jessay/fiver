        <mxCell id="flow2-bronze-db" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#0288D1;entryX=0;entryY=0.25;entryDx=0;entryDy=0;fontFamily=Amazon Ember;" edge="1" parent="aws-account" source="bronze-zone" target="databricks-main">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="flow3-db-silver" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#0288D1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=8 4;fontFamily=Amazon Ember;" edge="1" parent="aws-account" source="databricks-main" target="silver-zone">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow3-label" value="Transform" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#01579B;fontStyle=1;fontFamily=Amazon Ember;labelBackgroundColor=#E1F5FE;" vertex="1" connectable="0" parent="flow3-db-silver">
