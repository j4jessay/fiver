        </mxCell>

        <!-- Legend Column 2: GenAI -->
        <mxCell id="legend-col2" value="🤖 GENERATIVE AI:&#xa;• Foundation Models: Pre-trained LLMs (DBRX, Llama, GPT-4, Claude)&#xa;• Fine-Tuning: LoRA (low-rank adaptation), QLoRA (quantized)&#xa;• RAG: Retrieval-Augmented Generation (Vector Search + LLM)&#xa;• Agentic AI: Multi-agent systems with tool integration&#xa;• LangChain: Framework for LLM orchestration &amp; chains&#xa;• Mosaic AI Judge: Evaluate LLM outputs for quality&#xa;• Prompt Engineering: Optimize prompts for accuracy" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#333333;fontStyle=0" vertex="1" parent="1">
