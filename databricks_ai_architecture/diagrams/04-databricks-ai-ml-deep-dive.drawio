        <!-- Legend Column 1: Training -->
        <mxCell id="legend-col1" value="🎓 ML TRAINING:&#xa;• Spark ML: Distributed classic ML (regression, classification)&#xa;• Deep Learning: PyTorch, TensorFlow for neural networks&#xa;• AutoML: Automated model selection &amp; hyperparameter tuning&#xa;• Distributed: Horovod, Ray for multi-GPU/cluster training&#xa;• Hyperopt: Bayesian optimization for hyperparameters&#xa;• MLflow: Experiment tracking, model versioning&#xa;• Feature Store: Centralized, reusable features" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#333333;fontStyle=0" vertex="1" parent="1">
